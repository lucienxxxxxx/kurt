{
  "name": "kurt-tui",
  "version": "0.2.1",
  "description": "An Ink terminal UI for kurt-agent — a protocol-agnostic front-end consumer of the engine.",
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "kurt": "./src/cli.ts"
  },
  "private": true,
  "scripts": {
    "tui": "bun run src/cli.ts tui",
    "chat": "bun run src/cli.ts chat",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^7.0.5",
    "kurt-agent": "workspace:*",
    "marked": "^18.0.5",
    "marked-terminal": "^7.3.0",
    "react": "^19.2.7",
    "react-devtools-core": "^7.0.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/marked-terminal": "^6.1.1",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5"
  }
}
